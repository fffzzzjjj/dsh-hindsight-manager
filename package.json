{
  "name": "dsh-hindsight-manager",
  "version": "1.8.0",
  "private": false,
  "description": "Deploy and manage a local Hindsight memory bank inside DeepSeek Harness: guided setup (integration, model key, cache), daemon lifecycle, and a page to browse this repo's memory. · 在 DSH 里一键部署并管理本地 Hindsight 记忆库：引导安装记忆集成、填写模型密钥、启停守护进程，并浏览本仓库的记忆库。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fffzzzjjj/dsh-hindsight-manager.git"
  },
  "homepage": "https://github.com/fffzzzjjj/dsh-hindsight-manager#readme",
  "bugs": {
    "url": "https://github.com/fffzzzjjj/dsh-hindsight-manager/issues"
  },
  "type": "module",
  "main": "index.js",
  "icon": "assets/icon.svg",
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "hindsight",
    "memory",
    "agent-memory"
  ],
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./assets/icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/watchdog.mjs",
    "locale/*.json",
    "assets/icon.svg",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check index.js && node --check client.js && node --check lib/watchdog.mjs",
    "test": "node test/client-smoke.mjs && node test/host-smoke.mjs",
    "test:client": "node test/client-smoke.mjs",
    "test:host": "node test/host-smoke.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
